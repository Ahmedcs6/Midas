{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Midas.Api (.NET Launch)",
      "type": "netcoredbg",
      "request": "launch",
      "program": "${workspaceFolder}/Midas.Api/bin/Debug/net10.0/Midas.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Midas.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": ".NET Attach",
      "type": "netcoredbg",
      "request": "attach"
    }
  ]
}
